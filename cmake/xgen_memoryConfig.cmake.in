@PACKAGE_INIT@
set(xgen_memory_VERSION "@PROJECT_VERSION@")
include("${CMAKE_CURRENT_LIST_DIR}/xgen_memoryCheckTarget.cmake")
include(CMakeFindDependencyMacro)
set(_xgm_requested ${xgen_memory_FIND_COMPONENTS})
if(NOT _xgm_requested)
    set(_xgm_requested allocator)
endif()
set(_xgm_load ${_xgm_requested})
foreach(_xgm_component IN LISTS _xgm_requested)
    if(_xgm_component STREQUAL "size_class")
        list(APPEND _xgm_load allocator pool)
    elseif(_xgm_component MATCHES "^(pool|tracking|libc_allocator)$")
        list(APPEND _xgm_load allocator)
    endif()
endforeach()
list(REMOVE_DUPLICATES _xgm_load)
foreach(_xgm_component IN LISTS _xgm_requested)
    set(xgen_memory_${_xgm_component}_FOUND FALSE)
    if(NOT EXISTS "${CMAKE_CURRENT_LIST_DIR}/xgenMemory-${_xgm_component}Targets.cmake")
        set(xgen_memory_NOT_FOUND_MESSAGE "Unavailable xgen-memory component '${_xgm_component}'")
    endif()
endforeach()
set(_xgm_needs_status FALSE)
foreach(_xgm_component IN ITEMS pool arena size_class tracking)
    if(_xgm_component IN_LIST _xgm_load AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/xgenMemory-${_xgm_component}Targets.cmake")
        set(_xgm_needs_status TRUE)
    endif()
endforeach()
if(_xgm_needs_status)
    if(NOT TARGET xgs::status)
        find_dependency(xgen_status 0.1.0 EXACT CONFIG COMPONENTS status)
    endif()
    get_target_property(_xgm_status_version xgs::status XGS_VERSION)
    get_target_property(_xgm_status_abi xgs::status XGS_ABI_VERSION)
    get_target_property(_xgm_status_type xgs::status TYPE)
    if(NOT _xgm_status_version STREQUAL "0.1.0" OR NOT _xgm_status_abi STREQUAL "1" OR NOT _xgm_status_type STREQUAL "INTERFACE_LIBRARY")
        set(xgen_memory_FOUND FALSE)
        set(xgen_memory_NOT_FOUND_MESSAGE "xgs::status has incompatible version/ABI")
        return()
    endif()
endif()
foreach(_xgm_component IN ITEMS allocator pool size_class arena tracking libc_allocator)
    if(NOT _xgm_component IN_LIST _xgm_load OR NOT EXISTS "${CMAKE_CURRENT_LIST_DIR}/xgenMemory-${_xgm_component}Targets.cmake")
        continue()
    endif()
    if(NOT TARGET xgm::${_xgm_component})
        include("${CMAKE_CURRENT_LIST_DIR}/xgenMemory-${_xgm_component}Targets.cmake")
    endif()
    xgm_check_target(xgm::${_xgm_component} "@PROJECT_VERSION@" "@XGM_ABI_VERSION@" _xgm_error)
    if(_xgm_error)
        set(xgen_memory_FOUND FALSE)
        set(xgen_memory_NOT_FOUND_MESSAGE "${_xgm_error}")
        return()
    endif()
    set(xgen_memory_${_xgm_component}_FOUND TRUE)
endforeach()
check_required_components(xgen_memory)
unset(_xgm_requested)
unset(_xgm_load)
unset(_xgm_component)
unset(_xgm_needs_status)
unset(_xgm_status_version)
unset(_xgm_status_abi)
unset(_xgm_status_type)
unset(_xgm_error)
